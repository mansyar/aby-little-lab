{
  "name": "aby-little-lab",
  "version": "1.26.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24.0.0 <25" },
  "description": "An ad-free, distraction-free developmental game suite for preschoolers aged 3-5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "validate:module-size": "node scripts/validate-module-size.js",
    "validate:textures": "node scripts/validate-textures.js"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
